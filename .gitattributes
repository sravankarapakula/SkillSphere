# Auto detect text files and normalize line endings
* text=auto

# JavaScript / TypeScript
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Styles
*.css text eol=lf
*.scss text eol=lf

# HTML
*.html text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text

# Fonts
*.ttf binary
*.woff binary
*.woff2 binary

# Documents
*.pdf binary

# Lock files
package-lock.json text eol=lf
yarn.lock text eol=lf

# Prevent merge conflicts in package lock
package-lock.json merge=union